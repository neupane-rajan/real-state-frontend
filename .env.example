# ------------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy this file to `.env` (or `.env.local`) and adjust.
#
# WARNING: every VITE_* variable is embedded in the public JavaScript
# bundle. Never put secrets (API secrets, passwords, DB URLs) here.
# ------------------------------------------------------------------

# Base URL of the backend API, including the /api suffix.
# Local development:  http://localhost:3000/api
# Production:         https://<your-backend-host>/api
VITE_API_BASE_URL=http://localhost:3000/api
